import seaborn as sns
import matplotlib.pyplot as plt

def show_boxplots(data, title):
    # We have 9 numeric columns, so let's set up a 3x3 grid
    fig, axes = plt.subplots(3, 3, figsize=(16, 12))
    axes = axes.flatten()

    for i, col in enumerate(num_cols):
        sns.boxplot(y=data[col], ax=axes[i], color="skyblue")
        axes[i].set_title(col)
        axes[i].set_ylabel("")

    # Hide any unused axes (if there were fewer than 9 columns, though we have exactly 9)
    for j in range(len(num_cols), len(axes)):
        fig.delaxes(axes[j])

    fig.suptitle(title, fontsize=16, y=1.02)
    plt.tight_layout()
    plt.show()

